# Copy this to .env and fill in your values
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_key_here

# AI Model — uses Ollama locally, swap for cloud on Railway
# Option 1: Local Ollama (dev only)
OLLAMA_MODEL=deepseek-r1:14b
OLLAMA_BASE_URL=http://localhost:11434

# Option 2: OpenRouter (production — cheap, no GPU needed)
# OLLAMA_BASE_URL=https://openrouter.ai/api/v1
# OLLAMA_MODEL=deepseek/deepseek-r1
# OPENROUTER_API_KEY=sk-or-...
